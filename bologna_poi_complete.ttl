@prefix : <http://dati.comune.bologna.it/ontology/bologna-poi#> .
@prefix SM: <https://w3id.org/italia/onto/SM/> .
@prefix bo: <http://dati.comune.bologna.it/ontology/bologna-poi#> .
@prefix l0: <https://w3id.org/italia/onto/l0/> .
@prefix CLV: <https://w3id.org/italia/onto/CLV/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix poi: <http://dati.comune.bologna.it/resource/bologna-poi/> .
@prefix poiapit: <https://w3id.org/italia/onto/POI/> .
@prefix AccessCondition: <https://w3id.org/italia/onto/AccessCondition/> .
@base <http://dati.comune.bologna.it/ontology/bologna-poi> .

<http://dati.comune.bologna.it/ontology/bologna-poi> rdf:type owl:Ontology ;
                                                      owl:imports <https://w3id.org/italia/onto/POI> .

#################################################################
#    Annotation properties
#################################################################

###  https://w3id.org/italia/onto/AccessCondition/hasAccessCondition
AccessCondition:hasAccessCondition rdf:type owl:AnnotationProperty .


###  https://w3id.org/italia/onto/AccessCondition/opens
AccessCondition:opens rdf:type owl:AnnotationProperty .


###  https://w3id.org/italia/onto/CLV/fullAddress
CLV:fullAddress rdf:type owl:AnnotationProperty .


###  https://w3id.org/italia/onto/CLV/hasAddress
CLV:hasAddress rdf:type owl:AnnotationProperty .


###  https://w3id.org/italia/onto/CLV/hasCity
CLV:hasCity rdf:type owl:AnnotationProperty .


###  https://w3id.org/italia/onto/CLV/hasDistrict
CLV:hasDistrict rdf:type owl:AnnotationProperty .


###  https://w3id.org/italia/onto/SM/URL
SM:URL rdf:type owl:AnnotationProperty .


###  https://w3id.org/italia/onto/SM/hasWebSite
SM:hasWebSite rdf:type owl:AnnotationProperty .


###  https://w3id.org/italia/onto/l0/description
l0:description rdf:type owl:AnnotationProperty .


###  https://w3id.org/italia/onto/l0/name
l0:name rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://dati.comune.bologna.it/ontology/bologna-poi#hostsPOI
bo:hostsPOI rdf:type owl:ObjectProperty ;
            owl:inverseOf bo:isUnderPortico ;
            rdfs:domain bo:Portico ;
            rdfs:range bo:BolognaUrbanPointOfInterest ;
            rdfs:comment "Indica che un elemento strutturale o spaziale, come un portico, ospita fisicamente un punto di interesse urbano."@it ,
                         "Indicates that a structural or spatial element, such as a portico, physically hosts an urban point of interest."@en ;
            rdfs:label "Hosts POI"@en ,
                       "Ospita POI"@it .


###  http://dati.comune.bologna.it/ontology/bologna-poi#isUnderPortico
bo:isUnderPortico rdf:type owl:ObjectProperty ;
                  rdfs:domain bo:BolognaUrbanPointOfInterest ;
                  rdfs:range bo:Portico ;
                  rdfs:comment "Indicates whether an urban point of interest is located under a portico structure"@en ;
                  rdfs:label "is under portico"@en .


###  https://w3id.org/italia/onto/AccessCondition/hasAccessCondition
AccessCondition:hasAccessCondition rdfs:domain bo:BolognaUrbanPointOfInterest .


###  https://w3id.org/italia/onto/CLV/hasAddress
CLV:hasAddress rdfs:domain bo:BolognaUrbanPointOfInterest .


###  https://w3id.org/italia/onto/CLV/hasCity
CLV:hasCity rdfs:domain bo:BolognaUrbanPointOfInterest .


###  https://w3id.org/italia/onto/CLV/hasDistrict
CLV:hasDistrict rdfs:domain bo:BolognaUrbanPointOfInterest .


###  https://w3id.org/italia/onto/SM/hasWebSite
SM:hasWebSite rdfs:domain bo:Portico .


#################################################################
#    Data properties
#################################################################

###  http://dati.comune.bologna.it/ontology/bologna-poi#hasBusLine
bo:hasBusLine rdf:type owl:DatatypeProperty ;
              rdfs:domain bo:BusStop ;
              rdfs:range xsd:string ;
              rdfs:comment "Specifies the bus line serving a bus stop"@en ;
              rdfs:label "has Bus Line" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#hasBusStopCode
bo:hasBusStopCode rdf:type owl:DatatypeProperty ;
                  rdfs:domain bo:BusStop ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Specifies the official identifier code associated with a bus stop"@en ;
                  rdfs:label "has Bus Stop Code" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#hasBusStopName
bo:hasBusStopName rdf:type owl:DatatypeProperty ;
                  rdfs:domain bo:BusStop ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Specifies the name of a bus stop."@en ;
                  rdfs:label "has Bus Stop Name" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#hasCoordinates
bo:hasCoordinates rdf:type owl:DatatypeProperty ;
                  rdfs:domain bo:BolognaUrbanPointOfInterest ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Specifies the latitude and longitude coordinates associated with a point of interest"@en ;
                  rdfs:label "has Coordinates" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#hasCost
bo:hasCost rdf:type owl:DatatypeProperty ;
           rdfs:domain bo:PublicToilet ;
           rdfs:range xsd:string ;
           rdfs:comment "Specifies cost-related information associated with a public toilet or urban service."@en ;
           rdfs:label "has Cost" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#hasDistrict
bo:hasDistrict rdf:type owl:DatatypeProperty ;
               rdfs:domain bo:BolognaUrbanPointOfInterest ;
               rdfs:range xsd:string ;
               rdfs:comment "Specifies the district of Bologna where the point of interest is located"@en ;
               rdfs:label "has District" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#hasGeoShape
bo:hasGeoShape rdf:type owl:DatatypeProperty ;
               rdfs:domain bo:Portico ;
               rdfs:range xsd:string ;
               rdfs:comment "Represents the geospatial geometry associated with a point of interest."@en ;
               rdfs:label "has GeoShape" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#hasLISVideoGuide
bo:hasLISVideoGuide rdf:type owl:DatatypeProperty ;
                    rdfs:domain bo:Portico ;
                    rdfs:range xsd:anyURI ;
                    rdfs:comment "Specifies the URL of a video guide in Italian Sign Language associated with a portico"@en ;
                    rdfs:label "has LIS Video Guide" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#hasMaterial
bo:hasMaterial rdf:type owl:DatatypeProperty ;
               rdfs:domain bo:UrbanFurniture ;
               rdfs:range xsd:string ;
               rdfs:comment "Specifies the material composing an element of urban furniture"@en ;
               rdfs:label "has Material" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#hasMunicipality
bo:hasMunicipality rdf:type owl:DatatypeProperty ;
                   rdfs:domain bo:BolognaUrbanPointOfInterest ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Specifies the municipality where the point of interest is located"@en ;
                   rdfs:label "has Municipality" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#hasParkingCapacity
bo:hasParkingCapacity rdf:type owl:DatatypeProperty ;
                      rdfs:domain bo:ParkingArea ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "Specifies the number of available parking spaces in a parking area"@en ;
                      rdfs:label "has Parking Capacity" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#hasStructureType
bo:hasStructureType rdf:type owl:DatatypeProperty ;
                    rdfs:domain bo:ParkingArea ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Specifies the structural type of a parking area, such as surface-level or built structure"@en ;
                    rdfs:label "has Structure Type" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#hasTariff
bo:hasTariff rdf:type owl:DatatypeProperty ;
             rdfs:domain bo:ParkingArea ;
             rdfs:range xsd:string ;
             rdfs:comment "Specifies the tariff or payment condition associated with a parking area."@en ;
             rdfs:label "has Tariff" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#hasToiletType
bo:hasToiletType rdf:type owl:DatatypeProperty ;
                 rdfs:domain bo:PublicToilet ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Specifies the type of public toilet"@en ;
                 rdfs:label "has Toilet Type" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#isAccessible
bo:isAccessible rdf:type owl:DatatypeProperty ;
                rdfs:domain bo:PublicToilet ;
                rdfs:range xsd:boolean ;
                rdfs:comment "Indicates whether the point of interest is accessible to people with disabilities."@en ;
                rdfs:label "is Accessible" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#lastUpdated
bo:lastUpdated rdf:type owl:DatatypeProperty ;
               rdfs:domain bo:BolognaUrbanPointOfInterest ;
               rdfs:range xsd:date ;
               rdfs:comment "Specifies the date of the latest update of the information related to the point of interest."@en ;
               rdfs:label "last Updated" .


###  https://w3id.org/italia/onto/AccessCondition/opens
AccessCondition:opens rdfs:domain bo:BolognaUrbanPointOfInterest .


###  https://w3id.org/italia/onto/CLV/fullAddress
CLV:fullAddress rdfs:domain bo:BolognaUrbanPointOfInterest .


###  https://w3id.org/italia/onto/POI/POIID


###  https://w3id.org/italia/onto/SM/URL
SM:URL rdfs:domain bo:Portico .


###  https://w3id.org/italia/onto/l0/description
l0:description rdfs:domain bo:BolognaUrbanPointOfInterest .


###  https://w3id.org/italia/onto/l0/name
l0:name rdfs:domain bo:ParkingArea ,
                    bo:Portico .


#################################################################
#    Classes
#################################################################

###  http://dati.comune.bologna.it/ontology/bologna-poi#Bench
bo:Bench rdf:type owl:Class ;
         rdfs:subClassOf bo:UrbanFurniture ;
         rdfs:comment "A public bench belonging to the urban furniture category."@en ;
         rdfs:label "Bench"@en .


###  http://dati.comune.bologna.it/ontology/bologna-poi#Bin
bo:Bin rdf:type owl:Class ;
       rdfs:subClassOf bo:UrbanFurniture ;
       rdfs:comment "A public waste bin located in urban public spaces."@en ;
       rdfs:label "Waste Bin"@en .


###  http://dati.comune.bologna.it/ontology/bologna-poi#BolognaUrbanPointOfInterest
bo:BolognaUrbanPointOfInterest rdf:type owl:Class ;
                               rdfs:subClassOf poiapit:PointOfInterest ;
                               rdfs:comment ""@en ,
                                            "A local extension class representing urban points of interest and public proximity services in the city of Bologna"@en ;
                               rdfs:label "Bologna Urban Point Of Interest" .


###  http://dati.comune.bologna.it/ontology/bologna-poi#BusStop
bo:BusStop rdf:type owl:Class ;
           rdfs:subClassOf bo:BolognaUrbanPointOfInterest ;
           rdfs:comment "A public transport stop belonging to the Bologna TPER transport network."@en ;
           rdfs:label "Bus Stop"@en .


###  http://dati.comune.bologna.it/ontology/bologna-poi#Fountain
bo:Fountain rdf:type owl:Class ;
            rdfs:subClassOf bo:UrbanFurniture ;
            rdfs:comment "A public fountain available in the urban area of Bologna."@en ;
            rdfs:label "Public Fountain"@en .


###  http://dati.comune.bologna.it/ontology/bologna-poi#ParkingArea
bo:ParkingArea rdf:type owl:Class ;
               rdfs:subClassOf bo:BolognaUrbanPointOfInterest ;
               rdfs:comment "A public or private parking area located in the city of Bologna"@en ;
               rdfs:label "Parking Area"@en .


###  http://dati.comune.bologna.it/ontology/bologna-poi#Portico
bo:Portico rdf:type owl:Class ;
           rdfs:subClassOf bo:BolognaUrbanPointOfInterest ;
           rdfs:comment "A covered walkway supported by arches or columns, characteristic of the urban and architectural heritage of Bologna"@en ;
           rdfs:label "Portico"@en .


###  http://dati.comune.bologna.it/ontology/bologna-poi#PublicToilet
bo:PublicToilet rdf:type owl:Class ;
                rdfs:subClassOf bo:BolognaUrbanPointOfInterest ;
                rdfs:comment "A public toilet accessible within the urban area of Bologna"@en ;
                rdfs:label "Public Toilet"@en .


###  http://dati.comune.bologna.it/ontology/bologna-poi#UrbanFurniture
bo:UrbanFurniture rdf:type owl:Class ;
                  rdfs:subClassOf bo:BolognaUrbanPointOfInterest ;
                  rdfs:comment "Represents elements of urban furniture located in public spaces, such as benches, bins and fountains"@en ;
                  rdfs:label "Urban Furniture" .


